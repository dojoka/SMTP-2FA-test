# Copy this file to .env and fill in your own values.
# Find the SMTP login beside your SMTP key in Brevo's SMTP & API settings.
BREVO_SMTP_LOGIN=your-smtp-login@example.com
BREVO_SMTP_KEY=your-smtp-key

# Use a sender address configured for your Brevo account.
MAIL_FROM=verified-sender@example.com
# This local test app sends codes only to this address.
TEST_RECIPIENT=you@example.com

# SMTP relay settings. Port 465 uses implicit TLS and worked on this machine.
# Ports 587 and 2525 use STARTTLS if your network allows them.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=465

# Local web app port.
APP_PORT=8000
